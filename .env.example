# ── Database (Neon PostgreSQL) ─────────────────────────────
# Runtime connection: use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Migrations: use the DIRECT (non-pooled) connection string.
# (On Vercel + Neon this is provided as DATABASE_URL_UNPOOLED and is picked up automatically.)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Seed (used by `npm run db:seed`) ───────────────────────
SEED_OWNER_NAME="Business Owner"
SEED_OWNER_EMAIL="owner@example.com"
# Min 10 characters. This becomes your login password. Remove it from the file after seeding.
SEED_OWNER_PASSWORD=""

# ── Auth.js ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=""
