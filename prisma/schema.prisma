// DS Finance database schema.
// All money columns are NUMERIC(12,2). Transaction dates are DATE (no time),
// so they never shift across timezones (business timezone: Asia/Manila).
// Every top-level record belongs to a User so multi-user support can be added later.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum PaymentMethod {
  CASH
  GCASH
  BANK_TRANSFER
  OTHER
}

enum GcashTransactionType {
  CASH_IN
  CASH_OUT
  LOAD
}

enum GcashProvider {
  GCASH
  DITO
  TNT
  SMART
  GLOBE
  TM
  OTHER
}

enum DebtStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum AdjustmentType {
  SALARY
  REIMBURSEMENT
  OTHER_INCOME
  OTHER_ADJUSTMENT
}

// ───────────────────────── Models ─────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  saleCategories     SaleCategory[]
  serviceItems       ServiceItem[]
  sales              Sale[]
  gcashTransactions  GcashTransaction[]
  excessMoney        ExcessMoney[]
  reimbursements     Reimbursement[]
  employees          Employee[]
  salaryPeriods      SalaryPeriod[]
  salaryAdvances     SalaryAdvance[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  debts              Debt[]
  monthlyAdjustments MonthlyAdjustment[]
}

/// Sale item categories (Printing, Xerox, ...). A table instead of an enum so users can add custom ones.
model SaleCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        SaleItem[]
  serviceItems ServiceItem[]

  @@unique([userId, name])
}

/// Price list used by the Transactions calculator. A sale copies name and price into its own
/// SaleItem rows, so changing or deleting a service never alters past sales.
model ServiceItem {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  name       String
  price      Decimal  @db.Decimal(12, 2)
  /// Position inside its category on the Transactions page.
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category SaleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, name])
  @@index([userId])
  @@index([categoryId])
}

model Sale {
  id                String        @id @default(cuid())
  userId            String
  transactionNumber String
  transactionDate   DateTime      @db.Date
  customerName      String?
  paymentMethod     PaymentMethod @default(CASH)
  notes             String?
  /// Always recalculated on the server from the sale items.
  totalAmount       Decimal       @default(0) @db.Decimal(12, 2)
  /// Identifier used to detect duplicates when importing from Excel.
  importKey         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SaleItem[]

  @@unique([userId, transactionNumber])
  @@unique([userId, importKey])
  @@index([userId, transactionDate])
  @@index([paymentMethod])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  categoryId  String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  /// quantity * unitPrice, calculated on the server.
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sale     Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  category SaleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([categoryId])
}

/// Cash overage: extra cash found versus what the records say. Kept apart from sales income.
model ExcessMoney {
  id         String   @id @default(cuid())
  userId     String
  excessDate DateTime @db.Date
  amount     Decimal  @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, excessDate])
}

model GcashTransaction {
  id              String               @id @default(cuid())
  userId          String
  transactionDate DateTime             @db.Date
  transactionType GcashTransactionType
  provider        GcashProvider        @default(GCASH)
  /// Money moved. NOT revenue.
  amount          Decimal              @db.Decimal(12, 2)
  /// Fee earned on the transaction. This is the revenue part.
  charge          Decimal              @default(0) @db.Decimal(12, 2)
  notes           String?
  importKey       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, importKey])
  @@index([userId, transactionDate])
  @@index([transactionType])
  @@index([provider])
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  expenseDate DateTime @db.Date
  description String
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?
  importKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: a category that is in use cannot be deleted.
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, importKey])
  @@index([userId, expenseDate])
  @@index([categoryId])
}

model Debt {
  id             String     @id @default(cuid())
  userId         String
  name           String
  description    String?
  originalAmount Decimal    @db.Decimal(12, 2)
  debtDate       DateTime   @db.Date
  status         DebtStatus @default(UNPAID)
  importKey      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@unique([userId, importKey])
  @@index([userId, debtDate])
  @@index([status])
}

model DebtPayment {
  id          String   @id @default(cuid())
  debtId      String
  paymentDate DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?
  importKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@unique([debtId, importKey])
  @@index([debtId])
  @@index([paymentDate])
}

/// Salary, reimbursements and other items kept separate from ordinary sales.
/// `amount` is signed: positive adds to net income, negative subtracts from it.
model MonthlyAdjustment {
  id             String         @id @default(cuid())
  userId         String
  adjustmentDate DateTime       @db.Date
  adjustmentType AdjustmentType
  description    String
  amount         Decimal        @db.Decimal(12, 2)
  notes          String?
  importKey      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, importKey])
  @@index([userId, adjustmentDate])
  @@index([adjustmentType])
}

/// A person who is paid a monthly salary, split into two pay dates (the 15th and the 30th / month end).
model Employee {
  id            String   @id @default(cuid())
  userId        String
  name          String
  monthlySalary Decimal  @db.Decimal(12, 2)
  /// First day of the first month that has pay periods.
  startDate     DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  periods  SalaryPeriod[]
  advances SalaryAdvance[]

  @@unique([userId, name])
}

/// One pay date for one employee (half of the monthly salary).
model SalaryPeriod {
  id          String    @id @default(cuid())
  userId      String
  employeeId  String
  payDate     DateTime  @db.Date
  /// The salary for this pay date, before cash advances.
  grossAmount Decimal   @db.Decimal(12, 2)
  /// Set when the remaining balance has been paid out.
  paidOn      DateTime? @db.Date
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  advances SalaryAdvance[]

  @@unique([employeeId, payDate])
  @@index([userId, payDate])
}

/// Cash advance / salary advance, deducted from one pay date.
model SalaryAdvance {
  id          String   @id @default(cuid())
  userId      String
  employeeId  String
  periodId    String
  advanceDate DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period   SalaryPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([userId, advanceDate])
}

/// Money paid back to someone (e.g. an employee or the owner) for a business cost. Subtracted from net income.
model Reimbursement {
  id                String   @id @default(cuid())
  userId            String
  reimbursementDate DateTime @db.Date
  /// Who it was paid to and/or what for.
  description       String
  amount            Decimal  @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reimbursementDate])
}
